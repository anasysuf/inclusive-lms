# =========================================================================
# ACCESSILearn ENVIRONMENT VARIABLES (.env.example)
# =========================================================================

# Database Connection (Neon PostgreSQL / Local SQLite)
# Untuk Neon PostgreSQL di Vercel:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication Config
# Di Vercel Production: isi dengan domain Vercel Anda (e.g. https://inclusive-lms.vercel.app)
# Di Local: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Kunci Rahasia Enkripsi Sesi JWT (Generate dengan openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters"
